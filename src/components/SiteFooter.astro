---
import { SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner shell">
    <div>
      <p class="footer-name">MINJUN KIM · Mobile Engineer</p>
      <p class="footer-note">Swift, iOS, React Native 그리고 운영 가능한 설계.</p>
      <p class="footer-copyright">© {year} MINJUN KIM</p>
    </div>
    <nav class="footer-links" aria-label="외부 링크">
      <a href="/rss.xml">RSS</a>
      <a href={`mailto:${SITE.email}`}>Email</a>
      <a href={SITE.github} target="_blank" rel="me noopener noreferrer">GitHub</a>
      <a href={SITE.linkedin} target="_blank" rel="me noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</footer>
