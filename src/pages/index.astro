---
import { getCollection } from 'astro:content';
import PostRow from '../components/PostRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 3);
const visiblePosts = featuredPosts.length > 0 ? featuredPosts : posts.slice(0, 3);
---

<BaseLayout>
  <main id="main-content">
    <section class="hero shell" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow"><span class="signal" aria-hidden="true"></span> iOS · React Native</p>
        <h1 id="hero-title">
          모바일 엔지니어<br />
          <span class="muted-heading">김민준입니다.</span>
        </h1>
        <p class="hero-copy">
          iOS를 중심으로 React Native 앱도 개발해 왔습니다.
          MyD의 데이터·인증 연동, TBN의 방송·로그인 기능,
          장병e음 앱 내 모바일 신분증 기능을 개발했습니다.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/about/">경력·프로젝트 보기 <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/writing/">기술 글 읽기</a>
        </div>
      </div>

      <aside class="principle-card" aria-label="주요 개발 경험">
        <div class="principle-card-header">
          <p class="mono-label">주요 개발 경험</p>
          <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
        </div>
        <ol class="principle-list">
          <li>Swift · SwiftUI · UIKit</li>
          <li>React Native · TypeScript</li>
          <li>본인인증 · 소셜 로그인 · 모바일 신분증</li>
          <li>테스트 · 스토어 심사 · 배포</li>
        </ol>
      </aside>
    </section>

    <section class="home-section" aria-labelledby="featured-writing">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="mono-label">01 / Selected writing</p>
            <h2 id="featured-writing">개발 중 겪은 문제와<br />해결 방법</h2>
          </div>
          <p>
            앱 초기화 중복, 큰 이미지의 메모리 사용, 업데이트 정책 조회 실패를 다룹니다.
            설명을 위한 예제 코드와 테스트 방법을 함께 정리했습니다.
          </p>
        </div>
        <div class="post-list">
          {visiblePosts.map((post) => (
            <PostRow
              title={post.data.title}
              description={post.data.description}
              publishedAt={post.data.publishedAt}
              tags={post.data.tags}
              href={`/writing/${post.id}/`}
              featured={post.data.featured}
            />
          ))}
        </div>
        <div style="margin-top: 32px;">
          <a class="section-link" href="/writing/">모든 글 보기 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="work-title">
      <div class="shell split-copy">
        <div>
          <p class="mono-label">02 / Work</p>
          <h2 id="work-title">기능 개발부터<br />출시 후 오류 수정까지</h2>
        </div>
        <div class="split-copy-body">
          <p>
            데이터·본인인증 연동과 방송 기능을 구현하고, 테스트·스토어 심사·배포에 참여했습니다.
            출시 후에는 앱 초기화, 지역 정보, 백그라운드 청취 동작의 오류를 수정했습니다.
          </p>
          <p>
            2022년 6월부터 Personal AI(구 SNPLAB) 앱팀에서 일하고 있습니다.
            iOS 배포 파이프라인 재구축과 운영 인수인계도 맡았습니다.
          </p>
          <a class="section-link" href="/about/">담당 프로젝트 자세히 보기 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
