---
import { getCollection } from 'astro:content';
import PostRow from '../../components/PostRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title="Writing"
  description="앱 초기화, 이미지 다운샘플링, React Native 업데이트 처리를 예제와 테스트로 설명한 김민준의 기술 글입니다."
>
  <main id="main-content">
    <header class="page-heading shell">
      <p class="eyebrow">Writing / Mobile engineering notes</p>
      <h1>모바일 개발 중<br />겪은 문제와 해결 방법.</h1>
      <p class="page-heading-copy">
        문제가 생기는 조건과 처리 방법, 다시 확인할 테스트를 정리했습니다.
        코드는 설명을 위해 재구성한 예제이며, 회사의 실제 코드를 공개한 것은 아닙니다.
      </p>
      <p class="page-heading-meta">총 {posts.length}편 · 한국어</p>
    </header>

    <section class="page-section" aria-labelledby="all-writing-title">
      <div class="shell">
        <h2 id="all-writing-title" class="mono-label" style="margin-bottom: 32px;">All writing</h2>
        <div class="post-list">
          {posts.map((post) => (
            <PostRow
              title={post.data.title}
              description={post.data.description}
              publishedAt={post.data.publishedAt}
              tags={post.data.tags}
              href={`/writing/${post.id}/`}
              featured={post.data.featured}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
